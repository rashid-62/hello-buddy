# ============================================================
# Islamic History AI — Environment Variables
# ============================================================
# Copy this file to .env and insert your real keys.
# NEVER commit .env to GitHub.
#
# Where to put keys:
#   Local:  .env in the project root (used by npm start)
#   Netlify: Site settings → Environment variables
# ============================================================

# Required (primary AI provider)
# Get a free key at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Required (backup AI provider)
# Get a free key at: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Optional — reserved for a future Supabase/PostgreSQL upgrade
# DATABASE_URL=
